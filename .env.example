# Copy this file to .env and change what you need.
# Every value below is the default, so an empty .env works too.

# --- Answer model -------------------------------------------------------
# "ollama" = local and free (default), "gemini" = Google's free API tier
LLM_PROVIDER=ollama

OLLAMA_MODEL=granite4:tiny-h
OLLAMA_BASE_URL=http://localhost:11434

# Used by every "gemini" option. Get a key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-latest
GOOGLE_API_KEY=

# --- Embedding model ----------------------------------------------------
# "ollama"      = Granite Embedding via Ollama (default)
# "huggingface" = the same Granite model on CPU, no Ollama  (uv sync --extra hf)
# "gemini"      = Gemini Embedding API, no model in memory  (uv sync --extra gemini)
EMBEDDINGS_PROVIDER=ollama

OLLAMA_EMBED_MODEL=granite-embedding:278m
HF_EMBED_MODEL=ibm-granite/granite-embedding-278m-multilingual
GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional: hide Hugging Face's harmless symlink warning on Windows.
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
